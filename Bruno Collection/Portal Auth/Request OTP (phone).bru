meta {
  name: Request OTP (phone)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/public/providers/{{bookingSlug}}/otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Origin: {{portalOrigin}}
}

body:json {
  {
    "phone": "{{portalPhone}}",
    "channel": "WHATSAPP",
    "captchaToken": "{{captchaToken}}"
  }
}

script:post-response {
  const challenge = res.body?.data?.challenge;
  if (challenge) bru.setVar("otpChallenge", challenge);
}

docs {
  `phone` is E.164 and `channel` must be `WHATSAPP`; `SMS` gets a 400. One row per number holds
  the cooldown and failure count, and a resend replaces the code.

  Same 202 `{ challenge }` for every number, patient or not. A hit cap (3 per number per hour, 30 per
  provider per hour, `PORTAL_OTP_PAID_DAILY_CAP` numbers per day overall) answers the same 202 without
  sending.
  This sends a real, paid message: use your own number.
}
