meta {
  name: Verify OTP (phone)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/portal/{{bookingSlug}}/otp/verify
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Origin: {{portalOrigin}}
}

body:json {
  {
    "phone": "{{portalPhone}}",
    "code": "{{otpCode}}",
    "challenge": "{{otpChallenge}}"
  }
}

script:post-response {
  const token = res.body?.data?.csrfToken;
  if (token) bru.setVar("portalCsrfToken", token);
}

docs {
  Same as Verify OTP, with `phone` instead of `email`. There is no `channel`: the session takes it from
  the code that was sent. Returns `{ email: null, contact, contactChannel, expiresAt, csrfToken }`.
}
