meta {
  name: Logout
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/portal/logout
  body: none
  auth: none
}

headers {
  Origin: {{portalOrigin}}
  X-CSRF-Token: {{portalCsrfToken}}
}

script:post-response {
  bru.setVar("portalCsrfToken", "");
}

docs {
  Clears the `portal_session` cookie (204). The session is a stateless JWT: a copied cookie stays
  valid until it expires (at most 2h). Needs the session cookie, the exact Origin and the CSRF token.
}
