meta {
  name: Get Connection
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/google/connection?verify=false
  body: none
  auth: inherit
}

params:query {
  verify: false
}

docs {
  Google connection status for the signed-in provider (ADMIN/SUPER_ADMIN).

  `status`:
  - `connected`: usable for Google Meet.
  - `expired`: a stored connection Google rejected (or missing the Meet scope); reconnect.
  - `not_connected`: never connected, or disconnected manually.

  `verify=true` refreshes the token with Google before answering (sets `lastCheckedAt`, or
  marks the connection expired on `invalid_grant`). Limited to 5 per minute per provider (429).
  A daily `check-google-connections` job does the same for every active connection.
}

settings {
  encodeUrl: true
  timeout: 0
}
