meta {
  name: List Audit Logs
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/audit-logs
  body: none
  auth: none
}

params:query {
  entityType: USER
  entityId: 
  actionType: CREATE
  source: API
  ~source: PUBLIC_PORTAL
  actorId:
  ~portalPatientId:
  orderBy: eventTimeUtc
  order: desc
  page: 1
  pageSize: 20
}

docs {
  `source` can repeat (e.g. `source=JOB&source=PUBLIC_PORTAL`).
  `portalPatientId` lists one patient's portal activity (`PUBLIC_PORTAL` rows only): rows linked to that
  record, plus unlinked rows (logins, booking requests) of the portal actor of the patient's current email.
  Linked rows survive email changes and never mix records that share an email. It cannot be combined with
  `actorId`; an unknown or foreign patient gives an empty page.
}
