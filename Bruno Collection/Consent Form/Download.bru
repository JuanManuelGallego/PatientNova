meta {
  name: Download
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/consent-document/public/download/{{consentVersionId}}.pdf
  body: none
  auth: none
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Public link sent in the welcome message. The id is a consent version id, or a provider's user id (messages sent before patient types), which serves the current version of that provider's default type.
}
