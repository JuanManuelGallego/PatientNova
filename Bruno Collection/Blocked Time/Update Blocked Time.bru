meta {
  name: Update Blocked Time
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/blocked-time/{{blockedTimeId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "description": "Extended lunch break",
    "startTimeUtc": "2026-07-27T12:00:00.000Z",
    "endTimeUtc": "2026-07-27T13:30:00.000Z"
  }
}

docs {
  A block starts and ends on the same day in the provider's timezone (`User.timezone`): an end on the next day, or at the next midnight, answers 400 `A blocked time must start and end on the same day in the provider timezone`. Only a change to `startTimeUtc`/`endTimeUtc` is checked, so blocks saved across days before this rule can still have their description edited.
}
