meta {
  name: Create Medical Record
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/medical-records
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "patientId": "{{patientId}}",
    "name": "Maria García",
    "nationalId": "123456789",
    "sex": "FEMALE",
    "birthDate": "1990-03-15T00:00:00.000Z",
    "birthPlace": "Mexico City, Mexico",
    "data": {
      "consultationReason": "Anxiety and chronic stress management",
      "earlyDevelopment": "No notable issues reported.",
      "objective": "Reduce anxiety symptoms and improve coping strategies."
    },
    "familyMembers": [
      {
        "name": "Carlos García",
        "sex": "MALE",
        "age": "65",
        "relationship": "FATHER",
        "relation": "Father"
      }
    ],
    "evolutionNotes": [
      {
        "date": "2025-03-01T10:00:00.000Z",
        "text": "First session. Patient expressed openness to therapy."
      }
    ]
  }
}

docs {
  `data` holds the template answers, keyed by field key of the patient type's template (active fields only, strings up
  to 50,000 characters; an empty string is skipped). A removed or unknown key answers 400. The response carries `data`,
  `patientType` (template and family switches) and `snapshots`.
}
