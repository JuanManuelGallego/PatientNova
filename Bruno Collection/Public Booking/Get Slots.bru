meta {
  name: Get Slots
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/public/providers/{{bookingSlug}}/slots?typeId={{typeId}}&from={{from}}&to={{to}}
  body: none
  auth: none
}

params:query {
  typeId: {{typeId}}
  from: {{from}}
  to: {{to}}
}

script:pre-request {
  // The next 7 days, so the example never drifts into the past.
  const day = (n) => new Date(Date.now() + n * 86400000).toISOString().slice(0, 10);
  bru.setVar("from", day(0));
  bru.setVar("to", day(6));
}

script:post-response {
  // The first free slot, used by Portal Booking > Create Booking.
  const first = res.body?.data?.slots?.[0]?.startUtc;
  if (first) bru.setVar("slotStartUtc", first);
}
