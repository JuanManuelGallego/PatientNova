meta {
  name: Update Booking Settings
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/booking/settings
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "bookingSlug": "consulta-ejemplo",
    "bookingEnabled": false,
    "bookingApprovalMode": "AUTO_CONFIRM",
    "slotIntervalMinutes": 30,
    "bufferMinutes": 0,
    "minLeadMinutes": 120,
    "maxHorizonDays": 60,
    "maxPatientReschedules": 2,
    "minRescheduleNoticeHours": 0,
    "bio": "Atiendo adultos y parejas.",
    "specialty": "Psicología clínica",
    "professionalLicense": "TP 12345",
    "publicPhone": "+573001112222",
    "publicWhatsapp": "+573001112222"
  }
}

docs {
  `bookingApprovalMode`: `AUTO_CONFIRM` confirms portal bookings at once; `REQUIRE_APPROVAL` turns each
  one into a pending request that holds its slot (202) until the provider answers it in Booking Requests.
  Pending requests survive a switch back to `AUTO_CONFIRM`.
  `maxPatientReschedules` (0-10, 0 = patients cannot reschedule online) caps portal reschedules per
  appointment; `minRescheduleNoticeHours` (0-168) refuses a reschedule once the current start is that
  close. Cancelling has no cutoff.
  `bio` (600), `specialty` (120), `professionalLicense` (60), `publicPhone` and `publicWhatsapp` (E.164)
  appear on the public booking page. Empty string or null clears them. They are separate from the
  profile's `phoneNumber`/`whatsappNumber`, which stay private.
}
