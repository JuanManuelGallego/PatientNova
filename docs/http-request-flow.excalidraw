   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "authenticate\n• token from httpOnly cookie, else Bearer\n• verifyAccessToken: HS256 pinned, issuer\n  patientnova, audience provider\n  (refresh / portal tokens rejected)\n• payload shape check → req.user\n• cookie + POST/PUT/PATCH/DELETE: X-CSRF-Token\n  = HMAC(session sid) (Bearer exempt)\n• opens audit context (actor, IP, userId)",
   "originalText": "authenticate\n• token from httpOnly cookie, else Bearer\n• verifyAccessToken: HS256 pinned, issuer\n  patientnova, audience provider\n  (refresh / portal tokens rejected)\n• payload shape check → req.user\n• cookie + POST/PUT/PATCH/DELETE: X-CSRF-Token\n  = HMAC(session sid) (Bearer exempt)\n• opens audit context (actor, IP, userId)",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "authn",
   "lineHeight": 1.25,
   "autoResize": true
  },
