   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Public endpoint controls\n• Login: bcrypt, atomic failed-attempt\n  counter + lockout, masked email in logs\n• Issues access JWT (15 min) + refresh JWT\n  (7 days) as httpOnly, Secure cookies\n• Refresh: verifyRefreshToken + token\n  version (logout revokes)\n• Google callback: one-time OAuth state",
   "originalText": "Public endpoint controls\n• Login: bcrypt, atomic failed-attempt\n  counter + lockout, masked email in logs\n• Issues access JWT (15 min) + refresh JWT\n  (7 days) as httpOnly, Secure cookies\n• Refresh: verifyRefreshToken + token\n  version (logout revokes)\n• Google callback: one-time OAuth state",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "pub_sec",
   "lineHeight": 1.25,
   "autoResize": true
