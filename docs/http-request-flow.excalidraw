   "updated": 1,
   "link": null,
   "locked": false,
   "text": "10. Error mapping — handleError (asyncHandler) · errorHandler (global)\nApiError → its status · overlap violation → neutral 409\nentity.parse.failed → 400 · entity.too.large → 413 · other 4xx → \"Bad request\"\nanything else → 500, logged with requestId, err.message never returned",
   "originalText": "10. Error mapping — handleError (asyncHandler) · errorHandler (global)\nApiError → its status · overlap violation → neutral 409\nentity.parse.failed → 400 · entity.too.large → 413 · other 4xx → \"Bad request\"\nanything else → 500, logged with requestId, err.message never returned",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "eh",
   "lineHeight": 1.25,
   "autoResize": true
