# ──────────────────────────────────────────────
#  Playwright E2E — Environment
#  Copy to .env and fill in real values.
#  NEVER commit the actual .env to source control.
# ──────────────────────────────────────────────

# Base URL of the app under test
PLAYWRIGHT_BASE_URL=

# Test user credentials (must exist in the target environment)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Vercel deployment protection bypass token
# Get from: https://vercel.com/docs/security/deployment-protection
VERCEL_AUTOMATION_BYPASS_SECRET=