# Copy to .env.local. NEXT_PUBLIC_* values are inlined at build time.

# Backend API origin (no /v1 suffix). Required for a production build.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Cloudflare Turnstile site key for the patient portal (OTP request). There is no bypass: without it
# the widget shows an error and the form cannot be submitted. Local dev and CI use Cloudflare's
# always-pass test key below, paired with the test CAPTCHA_SECRET on the Server.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Optional error tracking (see docs/operations.md).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Set to true to enforce the Content-Security-Policy (report-only otherwise).
CSP_ENFORCE=false
