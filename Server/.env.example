# ──────────────────────────────────────────────
#  Twilio Notification Service — Environment
#  Copy to .env and fill in real values.
#  NEVER commit the actual .env to source control.
# ──────────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=info            # trace | debug | info | warn | error

# Twilio credentials — get from console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender numbers
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # Twilio sandbox or approved number
TWILIO_SMS_FROM=+15551234567                  # Your Twilio SMS number

# Brevo (EMAIL channel)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_FROM_EMAIL=no-reply@your-domain.com     # Must be a verified Brevo sender
BREVO_FROM_NAME=PatientNova
BREVO_WEBHOOK_SECRET=change-me-long-random-string

# Error tracking (optional). Leave SENTRY_DSN empty to disable. Events are scrubbed of PII before sending.
SENTRY_DSN=
# Optional overrides. Defaults: patientnova-server@$RAILWAY_GIT_COMMIT_SHA and $RAILWAY_ENVIRONMENT_NAME
# (then NODE_ENV) on Railway.
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000   # 1 minute window
RATE_LIMIT_MAX=30             # max requests per window per IP

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/patientnova?schema=public&connection_limit=20&pool_timeout=20"

# Connection Pool Settings
DATABASE_POOL_SIZE=20
DATABASE_POOL_MIN=5
DATABASE_CONNECTION_TIMEOUT=10000
DATABASE_IDLE_TIMEOUT=30000

# Authentication — shared secret used for JWT signing
# Generate with: openssl rand -hex 64
AUTH_SECRET=your-secure-random-string-at-least-32-chars
# Separate secret for patient portal sessions. Must differ from AUTH_SECRET.
# Generate with: openssl rand -hex 64
PORTAL_AUTH_SECRET=
# Parent domain for auth cookies in production (e.g. .patientnova.net). Leave empty locally.
COOKIE_DOMAIN=

# Seed only: read by db:seed-admin and db:seed-e2e, never by the server. Do not set them in production.
ADMIN_EMAIL="admin@patientnova.net"
ADMIN_PASSWORD="admin"

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","https://app.patientnova.net","https://patientnova.net"]


# Twilio Webhook — public base URL this server is reachable at (used for signature validation)
TWILIO_WEBHOOK_BASE_URL=https://your-server.com

# When true, pg-boss starts and owns all background scheduling (reminders,daily summaries, appointment auto-completion).
ENABLE_SCHEDULER=true

# Google API Credentials (optional — for Google Meet integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Portal URL (for OAuth completion redirect)
PORTAL_URL=http://localhost:3000

# Public patient-portal API (self-booking). Keep false until the portal is ready to launch.
ENABLE_SELF_SERVE=false
PORTAL_WHATSAPP_DAILY_CAP=60

# CAPTCHA for public portal endpoints: Cloudflare Turnstile in every environment (required).
# Use your widget's secret key; Cloudflare's test secret 1x0000000000000000000000000000000AA always passes.
CAPTCHA_SECRET=
# Comma-separated hostnames the widget may be solved on (defaults to the PORTAL_URL hostname).
CAPTCHA_EXPECTED_HOSTNAMES=

# Encryption — 256-bit key for AES-256-GCM column encryption
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Previous ENCRYPTION_KEY, still able to decrypt. Set only during a rotation. Procedure: "Rotating keys" in docs/operations.md
ENCRYPTION_KEY_PREVIOUS=

# HMAC key for blind indexes over encrypted patient PII (search, uniqueness). Must differ from
# ENCRYPTION_KEY. Required in production. Generate with: openssl rand -hex 32
BLIND_INDEX_KEY=
