{
  "name": "PatientNova_Server",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "main": "server.js",
  "scripts": {
    "build": "prisma generate && tsup",
    "typecheck": "tsc --noEmit",
    "start": "prisma migrate deploy && pnpm run pii:backfill && pnpm run db:seed-admin && node --enable-source-maps dist/server.js",
    "start:app": "node --enable-source-maps dist/server.js",
    "migrate:deploy": "prisma migrate deploy",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint . --ext .ts",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed-admin": "tsx src/utils/prisma/seed-admin.ts",
    "pii:backfill": "tsx src/utils/prisma/backfill-pii-cli.ts",
    "db:seed-e2e": "tsx src/utils/prisma/seed-e2e.ts",
    "db:format": "pnpm exec prisma db push",
    "db:wipe": "pnpm exec prisma migrate reset --force --skip-seed"
  },
  "author": "Juan Manuel Gallego",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.6",
    "@types/node": "^25.9.9",
    "@types/qs": "^6.15.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@google-apps/meet": "^0.11.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/node": "^11.8.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "twilio": "^6.2.0",
    "zod": "^4.6.7"
  }
}
